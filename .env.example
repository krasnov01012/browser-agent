# Канонический адрес сайта (canonical, hreflang, og:url). Домен ещё не выбран.
SITE_URL=https://krasnoff.example

# Endpoint приёма заявок (POST JSON, контракт — src/lib/leads.ts), например https://krasnoff.example/api/lead
# Пока переменная пустая, форма честно сообщает, что приём не подключён.
PUBLIC_LEADS_ENDPOINT=

# --- Только для server/leads-relay.mjs (НЕ PUBLIC_*, в сборку сайта не попадает) ---
# TELEGRAM_BOT_TOKEN=   # токен от @BotFather
# TELEGRAM_CHAT_ID=     # ваш chat id (узнать у @userinfobot) или id приватной группы
# ALLOWED_ORIGIN=https://krasnoff.example
# PORT=3100
# TRUST_PROXY=1
