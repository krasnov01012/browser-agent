---
/**
 * Project Architect — бриф в 4 шага (D22 PROPOSED). Не калькулятор: ни цен,
 * ни бюджета. Любой шаг можно пропустить; на шаге 4 — редактируемая сводка
 * и те же поля связи, что у короткой заявки. Черновик не сохраняется (приватность).
 */
import LeadFields from '@/components/intake/LeadFields.astro';
import Arrow from '@/components/ui/Arrow.astro';
import { t, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const a = t(locale).architect;
const capabilityGroups = a.types.filter((x) => x.id !== 'other');
---

<form class="arch" data-architect data-contact-form="brief" novalidate data-status="proposed">
  <ol class="arch__rail" aria-label={a.steps.join(' → ')}>
    {
      a.steps.map((s, i) => (
        <li>
          <button type="button" class="arch__rail-step" data-goto={i} aria-current={i === 0 ? 'step' : undefined}>
            <span class="label">{String(i + 1).padStart(2, '0')}</span>
            <span class="arch__rail-name">{s}</span>
          </button>
        </li>
      ))
    }
  </ol>

  <div class="arch__body">
    <p class="label arch__counter" aria-live="polite">
      {a.stepOf} <span data-step-now>1</span> / 4
    </p>

    <!-- 1 · Тип проекта -->
    <fieldset class="arch__step" data-step="0">
      <legend class="arch__q">{a.steps[0]}</legend>
      <p class="arch__hint">{a.multiHint}</p>
      <div class="chips">
        {
          a.types.map((type) => (
            <label class="chip">
              <input type="checkbox" name="types" value={type.id} data-label={type.label} />
              <span>{type.label}</span>
            </label>
          ))
        }
      </div>
      <input class="arch__text" type="text" name="other" maxlength="200" placeholder={a.otherPlaceholder} aria-label={a.otherPlaceholder} />
    </fieldset>

    <!-- 2 · Возможности (зависят от типа) -->
    <fieldset class="arch__step" data-step="1" hidden>
      <legend class="arch__q">{a.steps[1]}</legend>
      <p class="arch__hint" data-cap-empty>{a.capabilitiesEmpty}</p>
      {
        capabilityGroups.map((type) => (
          <div class="arch__group" data-cap-group={type.id} hidden>
            <p class="label">{type.label}</p>
            <div class="chips">
              {a.capabilities[type.id as keyof typeof a.capabilities].map((c) => (
                <label class="chip">
                  <input type="checkbox" name="capabilities" value={c} />
                  <span>{c}</span>
                </label>
              ))}
            </div>
          </div>
        ))
      }
      <textarea class="arch__text arch__text--area" name="capabilityNotes" rows="3" maxlength="1000" placeholder={a.capabilitiesNote} aria-label={a.capabilitiesNote}></textarea>
    </fieldset>

    <!-- 3 · Контекст -->
    <div class="arch__step" data-step="2" hidden>
      <p class="arch__q">{a.steps[2]}</p>
      <fieldset class="arch__sub">
        <legend class="label">{a.context.stageLabel}</legend>
        <div class="chips">
          {a.context.stages.map((v) => (
            <label class="chip"><input type="radio" name="stage" value={v} /><span>{v}</span></label>
          ))}
        </div>
      </fieldset>
      <fieldset class="arch__sub">
        <legend class="label">{a.context.materialsLabel}</legend>
        <div class="chips">
          {a.context.materials.map((v) => (
            <label class="chip"><input type="checkbox" name="materials" value={v} /><span>{v}</span></label>
          ))}
        </div>
      </fieldset>
      <fieldset class="arch__sub">
        <legend class="label">{a.context.timingLabel}</legend>
        <div class="chips">
          {a.context.timings.map((v) => (
            <label class="chip"><input type="radio" name="timing" value={v} /><span>{v}</span></label>
          ))}
        </div>
      </fieldset>
      <fieldset class="arch__sub">
        <legend class="label">{a.context.supportLabel}</legend>
        <div class="chips">
          {a.context.supports.map((v) => (
            <label class="chip"><input type="radio" name="support" value={v} /><span>{v}</span></label>
          ))}
        </div>
      </fieldset>
      <textarea class="arch__text arch__text--area" name="notes" rows="3" maxlength="1500" placeholder={a.context.notesPlaceholder} aria-label={a.context.notesPlaceholder}></textarea>
    </div>

    <!-- 4 · Сводка и отправка -->
    <div class="arch__step" data-step="3" hidden>
      <p class="arch__q">{a.summary.title}</p>
      <p class="arch__hint">{a.summary.hint}</p>
      <textarea
        class="arch__text arch__text--summary"
        name="description"
        rows="9"
        maxlength="5000"
        aria-label={a.summary.title}
        data-summary
        data-empty={a.summary.empty}
        data-h-type={a.summary.headings.type}
        data-h-capabilities={a.summary.headings.capabilities}
        data-h-stage={a.summary.headings.stage}
        data-h-materials={a.summary.headings.materials}
        data-h-timing={a.summary.headings.timing}
        data-h-support={a.summary.headings.support}
        data-h-notes={a.summary.headings.notes}
      ></textarea>
      <LeadFields locale={locale} id="brief" withMessage={false} />
    </div>

    <div class="arch__nav">
      <button type="button" class="btn btn--ghost" data-prev hidden>
        <Arrow dir="w" />
        <span>{a.back}</span>
      </button>
      <span class="arch__spacer"></span>
      <button type="button" class="link arch__skip" data-skip>{a.skip}</button>
      <button type="button" class="btn btn--primary" data-next>
        <span>{a.next}</span>
        <Arrow dir="e" />
      </button>
    </div>
  </div>
</form>

<style>
  .arch {
    display: grid;
    grid-template-columns: minmax(180px, 3fr) minmax(0, 9fr);
    gap: clamp(24px, 4vw, 64px);
  }

  /* ——— Рельс шагов ——— */
  .arch__rail {
    position: relative;
    display: grid;
    align-content: start;
    gap: 4px;
  }

  .arch__rail::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 14px;
    bottom: 14px;
    width: var(--hairline);
    background: var(--line);
  }

  .arch__rail-step {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 4px 12px;
    width: 100%;
    padding: 10px 0 10px 28px;
    text-align: left;
    color: var(--fg-faint);
    transition: color var(--dur-s) var(--ease-out);
  }

  .arch__rail-step::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 9px;
    height: 9px;
    margin-top: -4.5px;
    background: var(--bg);
    border: var(--hairline) solid var(--line-strong);
    transition: background-color var(--dur-s) var(--ease-out), border-color var(--dur-s) var(--ease-out);
  }

  .arch__rail-step[aria-current='step'] {
    color: var(--fg);
  }

  .arch__rail-step[aria-current='step']::before,
  .arch__rail-step[data-done]::before {
    background: var(--coral);
    border-color: var(--coral);
  }

  .arch__rail-step[data-done] {
    color: var(--fg-muted);
  }

  .arch__rail-name {
    font-size: 0.9375rem;
    font-weight: 500;
  }

  /* ——— Тело шага ——— */
  .arch__body {
    display: grid;
    align-content: start;
    gap: 24px;
    min-height: 420px;
  }

  .arch__counter {
    color: var(--coral);
  }

  .arch__step {
    display: grid;
    gap: 22px;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .arch__step:not([hidden]) {
    animation: arch-in var(--dur-m) var(--ease-out);
  }

  @keyframes arch-in {
    from {
      opacity: 0;
      transform: translateX(12px);
    }
  }

  .arch__q {
    padding: 0;
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .arch__hint {
    margin-top: -6px;
    color: var(--fg-muted);
    font-size: 0.9375rem;
  }

  .arch__sub {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .arch__group {
    display: grid;
    gap: 12px;
  }

  .arch__group[hidden] {
    display: none;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    position: relative;
    cursor: pointer;
  }

  .chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .chip span {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 46px;
    padding: 10px 16px;
    font-size: 0.9375rem;
    font-weight: 500;
    border: var(--hairline) solid var(--line-strong);
    border-radius: 2px;
    transition:
      background-color var(--dur-s) var(--ease-out),
      border-color var(--dur-s) var(--ease-out),
      color var(--dur-s) var(--ease-out);
  }

  .chip span::before {
    content: '';
    width: 7px;
    height: 7px;
    border: var(--hairline) solid currentColor;
    transform: rotate(45deg);
    opacity: 0.6;
    transition: background-color var(--dur-s) var(--ease-out);
  }

  .chip:hover span {
    border-color: var(--fg);
  }

  .chip input:checked + span {
    color: var(--graphite);
    background: var(--ivory);
    border-color: var(--ivory);
  }

  .chip input:checked + span::before {
    background: var(--coral);
    border-color: var(--coral);
    opacity: 1;
  }

  .chip input:focus-visible + span {
    outline: 2px solid var(--coral);
    outline-offset: 3px;
  }

  .arch__text {
    width: 100%;
    min-height: 54px;
    padding: 14px 16px;
    font-size: 1rem;
    color: var(--fg);
    background: var(--bg-panel);
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius);
  }

  .arch__text:focus-visible {
    outline: none;
    border-color: var(--coral);
  }

  .arch__text::placeholder {
    color: rgb(243 240 233 / 0.5);
  }

  .arch__text--area {
    min-height: 96px;
    resize: vertical;
  }

  .arch__text--summary {
    min-height: 220px;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.7;
    resize: vertical;
  }

  .arch__nav {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-top: 12px;
    border-top: var(--hairline) solid var(--line);
  }

  .arch__nav [hidden] {
    display: none;
  }

  .arch__spacer {
    flex: 1;
  }

  .arch__skip {
    color: var(--fg-muted);
  }

  @media (max-width: 1023px) {
    .arch {
      grid-template-columns: 1fr;
    }

    .arch__rail {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      gap: 8px;
    }

    .arch__rail::before {
      left: 0;
      right: 0;
      top: 4px;
      bottom: auto;
      width: auto;
      height: var(--hairline);
    }

    .arch__rail-step {
      grid-template-columns: 1fr;
      padding: 22px 0 0;
    }

    .arch__rail-step::before {
      top: 0;
      margin-top: 0;
    }

    .arch__rail-name {
      font-size: 0.8125rem;
    }
  }

  @media (max-width: 559px) {
    .arch__rail-name {
      display: none;
    }

    .arch__skip {
      display: none;
    }
  }
</style>
