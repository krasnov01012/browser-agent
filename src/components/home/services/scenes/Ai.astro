---
/**
 * AI и автоматизация: запрос → модель → проверки → решает человек.
 * Модель разбирает задачу и готовит ответ или действие; результат проверяет код (формат, правила, права);
 * важные действия — после подтверждения человека. Пунктир снизу — запасной путь без AI к той же карточке.
 */
import type { SceneText } from '@/content/serviceScenes';

interface Props {
  id: string;
  t: SceneText['ai'];
}
const { id, t } = Astro.props;
const tokens = [0, 1, 2, 3, 4, 5];
---

<g>
  <!-- Акт 1: запрос обычным языком -->
  <g class="ss-in1">
    <rect x="26" y="96" width="122" height="62" rx="8" class="ss-f"></rect>
    <path d="M40 158l-6 10 16-10" class="ss-f"></path>
    <text x="34" y="88">{t.input}</text>
  </g>
  {[108, 120, 132, 144].map((y, i) => <rect x="38" y={y} width={[96, 80, 92, 54][i]} height="5" rx="1" class="ss-dim ss-draw1" style={`--d: ${0.3 + i * 0.3}s`} />)}

  <!-- Акт 2: модель — токены уходят в ядро -->
  <g class="ss-in2">
    {tokens.map((i) => <rect x="-3" y="-3" width="6" height="6" class="ss-iv ss-run" style={`offset-path: path('M148 ${112 + (i % 3) * 12}C 170 ${112 + (i % 3) * 12}, 176 127, 200 127'); --d: ${i * 0.22}s; --run: 1.3s`} />)}
  </g>
  <g class="ss-pop2">
    <circle cx="232" cy="127" r="36" fill={`url(#ss-steel-${id})`} class="ss-l"></circle>
    <text x="232" y="131" text-anchor="middle" class="ss-ti ss-big">{t.model}</text>
  </g>
  <g class="ss-in2" style="--d: .3s">
    <circle cx="232" cy="127" r="48" class="ss-s ss-dash ss-spin" style="--spin: 14s"></circle>
    <circle cx="232" cy="127" r="58" class="ss-s ss-spin" stroke-dasharray="2 10" style="--spin: 22s"></circle>
    <circle cx="232" cy="69" r="3" class="ss-cf ss-glow"></circle>
    <text x="232" y="196" text-anchor="middle">{t.modelNote}</text>
  </g>

  <!-- Акт 3: программные проверки -->
  <path d="M268 127H302" class="ss-l ss-draw3"></path>
  <g class="ss-in3" style="--d: .2s">
    <rect x="302" y="88" width="80" height="78" rx="4" class="ss-f"></rect>
    <text x="310" y="101">{t.checks}</text>
    <path d="M302 106H382" class="ss-s"></path>
  </g>
  {
    t.items.map((c, i) => (
      <g class="ss-in3" style={`--d: ${0.6 + i * 0.45}s`}>
        <text x="310" y={122 + i * 16}>{c}</text>
        <path d={`M366 ${118 + i * 16}l3 3 6-7`} class="ss-c" />
      </g>
    ))
  }

  <!-- Акт 4: карточка подтверждения; решает человек -->
  <path d="M382 127H398V196" class="ss-l ss-drawv4"></path>
  <g class="ss-in4" style="--d: .3s">
    <rect x="300" y="196" width="156" height="72" rx="6" class="ss-f"></rect>
    <text x="310" y="212">{t.confirm}</text>
    <rect x="310" y="220" width="96" height="5" class="ss-iv"></rect>
    <rect x="310" y="230" width="70" height="4" class="ss-dim"></rect>
    <rect x="310" y="244" width="56" height="15" rx="2" class="ss-cf"></rect>
    <path d="M330 251l4 4 8-8" stroke="#0B0D11" stroke-width="1.8"></path>
    <rect x="372" y="244" width="56" height="15" rx="2" class="ss-l"></rect>
    <path d="M394 255l8-8 3 3-8 8h-3z" class="ss-l"></path>
  </g>
  <g class="ss-only4" style="--d: 1.2s">
    <circle cx="338" cy="252" r="10" class="ss-c ss-ring" style="--d: 10.4s"></circle>
  </g>
  <text x="300" y="284" class="ss-tc ss-in4" style="--d: 1.4s">{t.done}</text>

  <!-- Запасной путь без AI: пошаговая форма ведёт к той же карточке -->
  <path d="M86 168V236H300" class="ss-s ss-dash ss-draw4" style="--d: .1s"></path>
  <text x="96" y="230" class="ss-in4" style="--d: .4s">{t.fallback}</text>
</g>
