# ─── Провайдер LLM ────────────────────────────────────────────────
# zai | gemini | anthropic
LLM_PROVIDER=zai

# --- z.ai / GLM (прототип, бесплатные flash-модели) ---
# Ключ: https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# --- Gemini (запасной; из России недоступен без прокси) ---
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Anthropic (целевая конфигурация) ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ─── Модели по ролям ──────────────────────────────────────────────
# Замеры и обоснование выбора — docs/DECISIONS.md, ADR-008.
# glm-4.6v-flash: ~5-9 c, есть vision, кэша нет
# glm-4.5-flash:  ~15-23 c, кэш работает (527/528 токенов из кэша)
# glm-4.7-flash:  не использовать — отдаёт 429 под нагрузкой
MODEL_NAVIGATOR=glm-4.6v-flash
MODEL_EXTRACTOR=glm-4.5-flash
MODEL_VISION=glm-4.6v-flash
MODEL_FALLBACK=glm-4.5-flash

# GLM-*-flash — reasoning-модели, часть бюджета уходит в reasoning_content
MAX_OUTPUT_TOKENS=1500

# Переключение на Claude — заменить блок выше на:
# LLM_PROVIDER=anthropic
# MODEL_NAVIGATOR=claude-haiku-4-5-20251001
# MODEL_EXTRACTOR=claude-haiku-4-5-20251001
# MODEL_VISION=claude-sonnet-5
# MODEL_FALLBACK=claude-haiku-4-5-20251001

# ─── Браузер ──────────────────────────────────────────────────────
# Именно 127.0.0.1: Chrome слушает порт только на IPv4, а `localhost`
# на Windows резолвится сначала в ::1 — соединение не установится.
# Из Docker: http://host.docker.internal:9222
CDP_URL=http://127.0.0.1:9222

# ─── Бюджеты и лимиты ─────────────────────────────────────────────
MAX_STEPS=60
MAX_TASK_INPUT_TOKENS=400000
SNAPSHOT_TOKEN_BUDGET=4000
DOM_SETTLE_MS=500
DOM_SETTLE_TIMEOUT_MS=8000

# ─── Поведение ────────────────────────────────────────────────────
# Спрашивать подтверждение перед необратимыми действиями.
# По умолчанию выключено — так просил пользователь на брифинге.
CONFIRM_DESTRUCTIVE=false
# Переносить накопленные факты между запусками.
PERSIST_MEMORY=true

# ─── UI ───────────────────────────────────────────────────────────
UI_HOST=127.0.0.1
UI_PORT=8000

# ─── Пути (относительно корня репозитория) ────────────────────────
LOG_DIR=runs
MEMORY_DIR=memory
