---
/**
 * Политика обработки персональных данных — ЧЕРНОВИК-шаблон (src/content/legal.ts).
 * Поля [[…]] заполняет владелец, затем юридическая проверка (docs/LEGAL_GUIDE.md).
 * До запуска (PUBLIC_INDEXING != 1) страница не индексируется.
 */
import Base from '@/layouts/Base.astro';
import LegalBody from '@/components/LegalBody.astro';
import { policy } from '@/content/legal';
import { locales, type Locale } from '@/i18n';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
const doc = policy[locale];
const noindex = import.meta.env.PUBLIC_INDEXING !== '1';
---

<Base locale={locale} path="/privacy/" title={`${doc.title} — Krasnoff Development`} noindex={noindex}>
  <LegalBody doc={doc} />
</Base>
