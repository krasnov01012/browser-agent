---
import Lines from '@/components/ui/Lines.astro';
import Arrow from '@/components/ui/Arrow.astro';
import KBlueprint from '@/components/k/KBlueprint.astro';
import { describe } from '@/scripts/k/geometry';
import { t, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const geo = describe();
---

<section class="hero theme-dark" data-hero aria-labelledby="hero-title">
  <div class="hero__inner shell">
    <div class="hero__text">
      <p class="label hero__eyebrow" data-reveal>
        <span class="hero__tick" aria-hidden="true"></span>{dict.hero.eyebrow}
      </p>
      <Lines as="h1" id="hero-title" class="display hero__title" lines={dict.hero.titleLines} delay={120} status="draft" />
      <p class="lead hero__lead" data-reveal style="--reveal-i:4" data-status="draft">{dict.hero.lead}</p>
      <div class="hero__actions" data-reveal style="--reveal-i:5">
        <a class="btn btn--primary" href="#contact" data-intent-source="hero" data-intent="project">
          <span>{dict.hero.ctaPrimary}</span>
          <Arrow />
        </a>
        <a class="btn btn--ghost" href="#work">
          <span>{dict.hero.ctaSecondary}</span>
          <Arrow dir="down" />
        </a>
      </div>
    </div>

    <div class="k-stage" data-k-stage data-state="pending" data-status="proposed">
      <KBlueprint beamAngle={geo.beamAngle} stemWidth={geo.stemWidth} height={geo.height} />
      <img class="k-stage__poster" src="/media/k/architectural-k.svg" alt="" width="1000" height="1000" decoding="async" />
      <canvas class="k-stage__canvas" role="img" aria-label={dict.hero.kAlt}></canvas>
      <div class="k-stage__hud label" aria-hidden="true">
        <span class="k-stage__hud-model">{dict.hero.hud.model}</span>
        <span class="k-stage__hud-live">
          <span>{dict.hero.hud.assembly} <b data-hud-assembly>000%</b></span>
          <span>{dict.hero.hud.tilt} <b data-hud-tilt>+0.0° +0.0°</b></span>
        </span>
        <span class="k-stage__hud-static">{dict.hero.hud.fallback}</span>
      </div>
    </div>
  </div>

  <nav class="hero__caps shell" aria-label={dict.hero.capabilitiesLabel}>
    <ol class="hero__caps-list" data-reveal-group>
      {
        dict.services.items.map((s, i) => (
          <li data-reveal>
            <a href={`#service-${s.id}`} data-service-link={s.id}>
              <span class="label">{String(i + 1).padStart(2, '0')}</span>
              <span>{s.title}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</section>

<style>
  .hero {
    position: relative;
    min-height: max(100svh, 680px);
    display: grid;
    grid-template-rows: 1fr auto;
    padding-top: var(--header-h);
    overflow: clip;
    isolation: isolate;
  }

  /* Тихий тёплый свет за знаком — без «пятен», в пределах одной сцены. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(42% 52% at 74% 46%, rgb(255 101 72 / 0.07), transparent 70%),
      radial-gradient(60% 70% at 74% 46%, rgb(119 124 147 / 0.07), transparent 75%);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    align-items: center;
    padding-block: clamp(24px, 4vh, 56px);
  }

  .hero__text {
    grid-column: 1 / span 7;
    grid-row: 1;
    position: relative;
    z-index: 2;
    container-type: inline-size;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: clamp(20px, 3vh, 36px);
    color: var(--steel-light);
  }

  .hero__tick {
    width: 22px;
    height: var(--hairline);
    background: var(--coral);
  }

  /* Размер от ширины колонки: длинное «ПРОГРАММНЫЕ» и «SOFTWARE.» гарантированно влезают. */
  .hero__text :global(.hero__title) {
    font-size: min(16.6cqi, 8.5rem);
  }

  /* Самое длинное слово «ПРОГРАММНЫЕ» ≈ 7.46em — кегль считается от ширины колонки. */
  :global(:lang(ru)) .hero__text :global(.hero__title) {
    font-size: min(12.9cqi, 7.5rem);
  }

  .hero__lead {
    margin-top: clamp(24px, 3.4vh, 40px);
    max-width: 27em;
    color: rgb(243 240 233 / 0.74);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(28px, 4.2vh, 48px);
  }

  /* ——— Сцена K ——— */

  .k-stage {
    grid-column: 6 / span 7;
    grid-row: 1;
    justify-self: end;
    position: relative;
    width: min(100%, calc(100svh - var(--header-h) - 190px));
    min-width: 0;
    aspect-ratio: 1;
    margin-right: calc(var(--gutter) * -0.35);
  }

  .k-stage__canvas,
  .k-stage__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .k-stage__canvas {
    z-index: 1;
    opacity: 0;
    transition: opacity 600ms var(--ease-out);
  }

  .k-stage[data-state='live'] .k-stage__canvas {
    opacity: 1;
  }

  .k-stage[data-state='fallback'] .k-stage__canvas {
    display: none;
  }

  /* Постер виден без JS и при отказе WebGL; при живой сцене — нет. */
  .k-stage__poster {
    z-index: 1;
    opacity: 0;
    transition: opacity 700ms var(--ease-out);
  }

  :global(.no-js) .k-stage__poster,
  .k-stage[data-state='fallback'] .k-stage__poster {
    opacity: 1;
  }

  .k-stage__hud {
    position: absolute;
    left: 6%;
    right: 4%;
    bottom: 1%;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 0.6875rem;
    color: var(--steel-light);
    pointer-events: none;
  }

  .k-stage__hud b {
    font-weight: 500;
    color: var(--ivory);
    font-variant-numeric: tabular-nums;
  }

  .k-stage__hud-live {
    display: inline-flex;
    gap: 22px;
  }

  .k-stage__hud-static,
  .k-stage[data-state='fallback'] .k-stage__hud-live,
  :global(.no-js) .k-stage__hud-live {
    display: none;
  }

  .k-stage[data-state='fallback'] .k-stage__hud-static,
  :global(.no-js) .k-stage__hud-static {
    display: inline;
  }

  /* ——— Направления внизу Hero ——— */

  .hero__caps-list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-top: var(--hairline) solid var(--line);
  }

  .hero__caps-list a {
    display: grid;
    gap: 6px;
    height: 100%;
    padding: 18px 18px 26px 0;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.3;
    color: rgb(243 240 233 / 0.78);
    transition: color var(--dur-s) var(--ease-out);
  }

  .hero__caps-list li + li a {
    padding-left: 18px;
    border-left: var(--hairline) solid var(--line);
  }

  .hero__caps-list a:hover {
    color: var(--ivory);
  }

  .hero__caps-list a:hover .label {
    color: var(--coral);
  }

  @media (max-width: 1023px) {
    .hero__text {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .k-stage {
      grid-column: 1 / -1;
      grid-row: 1;
      justify-self: center;
      width: min(100%, 46svh, 560px);
      margin: 0 auto clamp(8px, 2vh, 24px);
    }

    .hero__text :global(.hero__title) {
      font-size: min(16cqi, 6.5rem);
    }

    :global(:lang(ru)) .hero__text :global(.hero__title) {
      font-size: min(12.9cqi, 5.5rem);
    }
  }

  @media (max-width: 767px) {
    .hero {
      min-height: auto;
    }

    .hero__caps {
      display: none;
    }

    .hero__inner {
      padding-bottom: 56px;
    }

    .k-stage__hud-live > span:last-child {
      display: none;
    }
  }
</style>
