---
/**
 * Лёгкие технические схемы для панели услуг (SVG + CSS, без библиотек).
 * Каждая показывает суть направления, а не «иконку»: слои интерфейса, модули,
 * AI-запрос с проверкой, поток данных, серверная топология.
 */
interface Props {
  kind: string;
}
const { kind } = Astro.props;
---

<svg class={`sd sd--${kind}`} viewBox="0 0 400 240" aria-hidden="true" fill="none">
  {
    kind === 'web' && (
      <g>
        <g class="sd-layer sd-layer--3">
          <rect x="132" y="22" width="220" height="150" rx="3" />
          <path d="M132 40 H352" />
        </g>
        <g class="sd-layer sd-layer--2">
          <rect x="96" y="46" width="220" height="150" rx="3" />
          <path d="M96 64 H316" />
          <path d="M112 84 H196 M112 96 H172" class="sd-soft" />
        </g>
        <g class="sd-layer sd-layer--1">
          <rect x="60" y="70" width="220" height="150" rx="3" class="sd-fill" />
          <path d="M60 88 H280" />
          <circle cx="70" cy="79" r="2.5" class="sd-dot" />
          <circle cx="79" cy="79" r="2.5" />
          <circle cx="88" cy="79" r="2.5" />
          <rect x="76" y="104" width="92" height="56" rx="2" class="sd-soft" />
          <path d="M184 108 H262 M184 120 H244 M184 132 H254" class="sd-soft" />
          <rect x="184" y="146" width="56" height="16" rx="2" class="sd-signal-fill" />
          <path d="M76 178 H262 M76 192 H220" class="sd-soft" />
        </g>
      </g>
    )
  }
  {
    kind === 'systems' && (
      <g>
        <path d="M110 70 H200 V120 M290 70 H200 M110 170 H200 V120 M290 170 H200" class="sd-wire" />
        <rect x="160" y="96" width="80" height="48" rx="2" class="sd-fill" />
        <text x="200" y="125" text-anchor="middle">CORE</text>
        {[
          [40, 50, 'CRM'],
          [290, 50, 'ADMIN'],
          [40, 150, 'API'],
          [290, 150, 'REPORTS'],
        ].map(([x, y, l]) => (
          <g>
            <rect x={x} y={y} width="70" height="40" rx="2" />
            <text x={Number(x) + 35} y={Number(y) + 24} text-anchor="middle">
              {l}
            </text>
          </g>
        ))}
        <circle r="4" class="sd-pulse">
          <animateMotion dur="3.2s" repeatCount="indefinite" path="M110 70 H200 V120 V170 H290" />
        </circle>
      </g>
    )
  }
  {
    kind === 'ai' && (
      <g>
        <path d="M20 120 H120" class="sd-wire" />
        <circle cx="160" cy="120" r="40" />
        <circle cx="160" cy="120" r="26" class="sd-soft sd-spin" stroke-dasharray="4 6" />
        <text x="160" y="124" text-anchor="middle">LLM</text>
        <path d="M200 120 H250" class="sd-wire" />
        <path d="M280 92 L308 120 L280 148 L252 120 Z" class="sd-fill" />
        <text x="280" y="124" text-anchor="middle">✓</text>
        <path d="M308 120 H380" class="sd-wire sd-wire--signal" />
        <path d="M280 148 V200 H120" class="sd-wire sd-soft" stroke-dasharray="3 5" />
        <text x="200" y="216" text-anchor="middle" class="sd-caption">RULES · VALIDATION</text>
        <text x="20" y="108">INPUT</text>
        <text x="380" y="108" text-anchor="end" class="sd-signal-text">OUTPUT</text>
        <circle r="4" class="sd-pulse">
          <animateMotion dur="3.6s" repeatCount="indefinite" path="M20 120 H120 M200 120 H380" />
        </circle>
      </g>
    )
  }
  {
    kind === 'data' && (
      <g>
        {[54, 100, 146, 192].map((y, i) => (
          <g>
            <rect x="20" y={y - 14} width="56" height="28" rx="2" />
            <text x="48" y={y + 4} text-anchor="middle">
              {['API', 'CSV', 'CRM', 'SHOP'][i]}
            </text>
            <path d={`M76 ${y} C 120 ${y}, 130 120, 170 120`} class="sd-wire" />
          </g>
        ))}
        <rect x="170" y="100" width="74" height="40" rx="2" class="sd-fill" />
        <text x="207" y="124" text-anchor="middle">ETL</text>
        <path d="M244 120 H282" class="sd-wire" />
        <ellipse cx="306" cy="92" rx="24" ry="8" />
        <path d="M282 92 V148 A24 8 0 0 0 330 148 V92" />
        <path d="M282 110 A24 8 0 0 0 330 110 M282 129 A24 8 0 0 0 330 129" class="sd-soft" />
        <path d="M352 196 V170 M364 196 V150 M376 196 V160 M388 196 V138" class="sd-bars" />
        <path d="M330 120 H346 V190" class="sd-wire sd-soft" />
        <circle r="3.5" class="sd-pulse">
          <animateMotion dur="2.8s" repeatCount="indefinite" path="M76 54 C 120 54, 130 120, 170 120 H282" />
        </circle>
        <circle r="3.5" class="sd-pulse sd-pulse--late">
          <animateMotion dur="2.8s" begin="1.1s" repeatCount="indefinite" path="M76 192 C 120 192, 130 120, 170 120 H282" />
        </circle>
      </g>
    )
  }
  {
    kind === 'infra' && (
      <g>
        {[40, 92, 144].map((y, i) => (
          <g>
            <rect x="60" y={y} width="170" height="40" rx="2" class={i === 0 ? 'sd-fill' : ''} />
            <path d={`M76 ${y + 14} H150 M76 ${y + 26} H128`} class="sd-soft" />
            <circle cx="206" cy={y + 20} r="4" class={i === 1 ? 'sd-led sd-led--beat' : 'sd-led'} />
            <circle cx="192" cy={y + 20} r="4" class="sd-soft" />
          </g>
        ))}
        <path d="M230 60 H290 M230 112 H290 M230 164 H290 M290 60 V164" class="sd-wire" />
        <path d="M290 112 H316" class="sd-wire" />
        <path d="M330 86 L356 96 V118 C356 132 344 140 330 146 C316 140 304 132 304 118 V96 Z" />
        <text x="330" y="121" text-anchor="middle">TLS</text>
        <path d="M60 206 H230" class="sd-soft" />
        <path d="M60 206 H230" class="sd-uptime" />
        <text x="60" y="226">MONITORING · BACKUPS</text>
      </g>
    )
  }
</svg>

<style>
  .sd {
    width: 100%;
    height: auto;
    overflow: visible;
    color: var(--ivory);
  }

  .sd :is(rect, path, circle, ellipse) {
    stroke: rgb(243 240 233 / 0.42);
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
  }

  .sd text {
    fill: var(--steel-light);
    stroke: none;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
  }

  .sd .sd-soft {
    stroke: rgb(243 240 233 / 0.18);
  }

  /* Непрозрачная заливка: провода и слои позади не просвечивают сквозь блок */
  .sd .sd-fill {
    fill: #171a1f;
    stroke: rgb(243 240 233 / 0.7);
  }

  .sd .sd-signal-fill {
    fill: var(--coral);
    stroke: none;
  }

  .sd .sd-dot {
    fill: var(--coral);
    stroke: none;
  }

  .sd .sd-wire {
    stroke: rgb(243 240 233 / 0.5);
  }

  .sd .sd-wire--signal,
  .sd .sd-signal-text {
    stroke: var(--coral);
    fill: var(--coral);
  }

  .sd .sd-wire--signal {
    fill: none;
  }

  .sd .sd-pulse {
    fill: var(--coral);
    stroke: none;
    filter: drop-shadow(0 0 6px var(--coral));
  }

  .sd .sd-led {
    fill: rgb(243 240 233 / 0.6);
    stroke: none;
  }

  .sd .sd-led--beat {
    fill: var(--coral);
  }

  .sd .sd-bars {
    stroke: var(--coral);
    stroke-width: 6;
    stroke-linecap: butt;
  }

  .sd .sd-uptime {
    stroke: var(--coral);
    stroke-dasharray: 170;
    stroke-dashoffset: 170;
  }

  .sd .sd-caption {
    font-size: 9px;
  }

  /* Анимации только у активной панели и только если движение разрешено */
  :global(.motion [data-active]) .sd-layer {
    animation: sd-lift 900ms var(--ease-out) both;
  }

  :global(.motion [data-active]) .sd-layer--2 {
    animation-delay: 80ms;
  }

  :global(.motion [data-active]) .sd-layer--3 {
    animation-delay: 160ms;
  }

  @keyframes sd-lift {
    from {
      transform: translate(-14px, 14px);
      opacity: 0;
    }
  }

  :global(.motion [data-active]) .sd-spin {
    animation: sd-spin 8s linear infinite;
    transform-origin: 160px 120px;
  }

  @keyframes sd-spin {
    to {
      transform: rotate(360deg);
    }
  }

  :global(.motion [data-active]) .sd-led--beat {
    animation: sd-beat 1.6s ease-in-out infinite;
  }

  @keyframes sd-beat {
    50% {
      opacity: 0.25;
    }
  }

  :global(.motion [data-active]) .sd-uptime {
    animation: sd-line 2.4s var(--ease-mech) forwards;
  }

  @keyframes sd-line {
    to {
      stroke-dashoffset: 0;
    }
  }

  :global(.motion [data-active]) .sd-bars {
    animation: sd-bars 1.1s var(--ease-out) both;
    transform-origin: 0 196px;
  }

  @keyframes sd-bars {
    from {
      transform: scaleY(0);
    }
  }

  /* SMIL-точки не нужны без движения */
  :global(html:not(.motion)) .sd-pulse {
    display: none;
  }
</style>
