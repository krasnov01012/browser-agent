---
import type { LegalDoc } from '@/content/legal';

interface Props {
  doc: LegalDoc;
}
const { doc } = Astro.props;
---

<section class="section theme-light legal" data-status="placeholder">
  <div class="shell">
    <p class="label label--accent">Legal / draft</p>
    <h1 class="h2">{doc.title}</h1>
    <p class="legal__banner">{doc.banner}</p>
    <p class="label">{doc.updated}</p>
    <div class="legal__body">
      {
        doc.sections.map((s) => (
          <section>
            <h2>{s.h}</h2>
            {s.p.map((text) => <p>{text}</p>)}
          </section>
        ))
      }
    </div>
  </div>
</section>

<style>
  .legal {
    min-height: 80svh;
    padding-top: calc(var(--header-h) + var(--section-y));
  }

  .legal .shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    max-width: 820px;
    margin-left: 0;
  }

  /* длинные русские заголовки: кегль от ширины экрана */
  .legal .h2 {
    font-size: clamp(1.375rem, 5.2vw, 3.25rem);
    overflow-wrap: anywhere;
  }

  .legal__banner {
    margin: 0;
    padding: 12px 16px;
    border-left: 2px solid var(--coral-strong);
    background: rgba(255, 101, 72, 0.08);
    font-size: 0.9375rem;
  }

  .legal__body {
    display: grid;
    gap: 28px;
    margin-top: 12px;
  }

  .legal__body h2 {
    margin: 0 0 8px;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .legal__body p {
    margin: 0 0 10px;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
</style>
