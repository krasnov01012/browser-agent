---
/**
 * 03 Опыт продукта: вкладки «Создать / Изменить / Итоги». Сцена слева — место
 * под реальную запись Telegram (data-media-slot); до записи — подписанная схема
 * сценария, а не поддельный интерфейс. Без автопереключения вкладок.
 */
import CaseHead from '@/components/cases/CaseHead.astro';
import { seshat } from '@/content/seshat';
import type { Locale } from '@/i18n';

interface Props {
  locale: Locale;
}
const c = seshat[Astro.props.locale].experience;
---

<section class="s-exp section" id="experience" data-scene="experience" aria-labelledby="s-exp-title">
  <div class="shell" data-tabs>
    <div class="s-exp__top">
      <CaseHead index={c.index} lines={c.titleLines} id="s-exp-title" />
      <div class="s-exp__tabs" role="tablist" aria-label={c.index}>
        {
          c.tabs.map((tab, i) => (
            <button
              class="s-exp__tab"
              type="button"
              role="tab"
              id={`s-exp-tab-${tab.id}`}
              aria-controls={`s-exp-panel-${tab.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              <span class="label">{String(i + 1).padStart(2, '0')}</span>
              {tab.label}
            </button>
          ))
        }
      </div>
    </div>

    <div class="s-exp__panels">
      {
        c.tabs.map((tab, i) => (
          <div class="s-exp__panel" role="tabpanel" id={`s-exp-panel-${tab.id}`} aria-labelledby={`s-exp-tab-${tab.id}`} tabindex="0" data-tab-hidden={i !== 0 ? '' : undefined}>
            <figure class="s-exp__stage" data-media-slot={`seshat-${tab.id}.mp4 · 5–12 s`} data-status="placeholder">
              <div class="s-exp__bubble">
                <span class="label">USER → BOT</span>
                <p>«{tab.message}»</p>
              </div>
              <ol class="s-exp__chain">
                {tab.steps.slice(1).map((s, k) => (
                  <li style={`--k:${k}`}>
                    <span class="s-exp__node" aria-hidden="true" />
                    {s}
                  </li>
                ))}
              </ol>
              <figcaption class="provenance">{c.pending}</figcaption>
            </figure>
            <div class="s-exp__copy">
              <p class="s-exp__caption">{tab.caption}</p>
              <p class="label">{c.stepsLabel}</p>
              <ol class="s-exp__steps">
                {tab.steps.map((s, k) => (
                  <li>
                    <span class="label">{String(k + 1).padStart(2, '0')}</span>
                    {s}
                  </li>
                ))}
              </ol>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .s-exp {
    --bg: var(--seshat-panel);
    --fg: var(--ivory);
    --fg-muted: rgb(243 240 233 / 0.68);
    --fg-faint: #b19aa6;
    --line: rgb(229 107 119 / 0.18);
    --line-strong: rgb(229 107 119 / 0.4);
    --accent: var(--seshat-signal);
    --signal: var(--seshat-signal);
    background: var(--bg);
    color: var(--fg);
  }

  .s-exp__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    flex-wrap: wrap;
    margin-bottom: clamp(40px, 5vw, 72px);
  }

  .s-exp__top :global(.chead) {
    margin-bottom: 0;
  }

  .s-exp__tabs {
    display: flex;
    gap: 6px;
    padding: 6px;
    border: var(--hairline) solid var(--line);
    border-radius: 3px;
  }

  .s-exp__tab {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 20px;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-muted);
    border-radius: 2px;
    transition: background-color var(--dur-s) var(--ease-out), color var(--dur-s) var(--ease-out);
  }

  .s-exp__tab:hover {
    color: var(--fg);
  }

  .s-exp__tab[aria-selected='true'] {
    color: var(--seshat-wine);
    background: var(--seshat-signal);
  }

  .s-exp__tab[aria-selected='true'] .label {
    color: var(--seshat-wine);
  }

  .s-exp__panel {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--col-gap);
  }

  .s-exp__panel:not([hidden]) {
    animation: s-exp-in 320ms var(--ease-out);
  }

  @keyframes s-exp-in {
    from {
      opacity: 0;
    }
  }

  .s-exp__stage {
    position: relative;
    display: grid;
    align-content: center;
    gap: 28px;
    min-height: clamp(360px, 38vw, 520px);
    padding: clamp(24px, 4vw, 56px);
    background:
      radial-gradient(60% 80% at 20% 30%, rgb(229 107 119 / 0.12), transparent 70%),
      var(--seshat-wine);
    border: var(--hairline) solid var(--line);
    border-radius: 4px;
  }

  .s-exp__bubble {
    justify-self: start;
    display: grid;
    gap: 8px;
    max-width: 30em;
    padding: 18px 22px;
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    line-height: 1.3;
    letter-spacing: -0.015em;
    background: rgb(243 240 233 / 0.07);
    border: var(--hairline) solid rgb(243 240 233 / 0.14);
    border-radius: 3px;
  }

  .s-exp__chain {
    display: grid;
    gap: 0;
    padding-left: 22px;
    border-left: var(--hairline) solid var(--line-strong);
  }

  .s-exp__chain li {
    position: relative;
    padding: 10px 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: rgb(243 240 233 / 0.82);
  }

  .s-exp__node {
    position: absolute;
    left: -27px;
    top: 50%;
    width: 9px;
    height: 9px;
    margin-top: -4.5px;
    background: var(--seshat-wine);
    border: 1.5px solid var(--seshat-signal);
  }

  .s-exp__chain li:last-child .s-exp__node {
    background: var(--seshat-signal);
  }

  :global(.motion) .s-exp__panel:not([hidden]) .s-exp__chain li {
    animation: s-exp-step 500ms var(--ease-out) both;
    animation-delay: calc(200ms + var(--k) * 140ms);
  }

  @keyframes s-exp-step {
    from {
      opacity: 0;
      transform: translateX(-10px);
    }
  }

  .s-exp__copy {
    display: grid;
    align-content: start;
    gap: 18px;
    padding: clamp(8px, 2vw, 32px) 0 0 clamp(0px, 2vw, 32px);
  }

  .s-exp__caption {
    font-size: var(--fs-h3);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: 12px;
  }

  .s-exp__steps li {
    display: grid;
    grid-template-columns: 40px 1fr;
    padding-block: 14px;
    border-top: var(--hairline) solid var(--line);
    color: var(--fg-muted);
  }

  .s-exp__steps .label {
    color: var(--accent);
    padding-top: 0.2em;
  }

  @media (max-width: 1023px) {
    .s-exp__panel {
      grid-template-columns: 1fr;
    }

    .s-exp__copy {
      padding-left: 0;
    }
  }

  @media (max-width: 559px) {
    .s-exp__tabs {
      width: 100%;
    }

    .s-exp__tab {
      flex: 1;
      justify-content: center;
      padding: 0 8px;
    }

    .s-exp__tab .label {
      display: none;
    }
  }
</style>
