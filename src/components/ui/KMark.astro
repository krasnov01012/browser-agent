---
/**
 * Плоская «Modular K» (v03) — модули из src/scripts/k/modular.ts в том же пространстве 1000×1000.
 * Упрощена для размеров 16–60 px: тонкая планка S3 слита с опорой, каждый модуль сжат внутрь на 6 единиц
 * (щели ≈ 20–25 единиц — видны уже в шапке 30 px). Коралловая диагональная вставка S4 — «светящийся шов»
 * 3D-знака. Используется в шапке, подвале, 404 и favicon — не замена 3D-знаку в Hero.
 */
interface Props {
  class?: string;
  title?: string;
}
const { class: className, title } = Astro.props;
---

<svg
  class:list={['kmark', className]}
  viewBox="123 125 754 750"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
>
  <polygon points="217,131 361,131 361,307" fill="currentColor" opacity="0.82"></polygon>
  <polygon points="129,131 185,131 361,341 361,618 129,405" fill="currentColor"></polygon>
  <polygon class="kmark__seam" points="129,437 361,651 361,693 129,480" fill="var(--coral)"></polygon>
  <polygon points="129,513 361,726 361,869 129,869" fill="currentColor"></polygon>
  <polygon points="396,427 653,170 871,170 871,178 573,472 396,472" fill="currentColor" opacity="0.8"></polygon>
  <polygon points="396,538 572,538 871,860 871,869 668,869 396,596" fill="currentColor" opacity="0.92"></polygon>
</svg>
