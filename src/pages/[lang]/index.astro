---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/home/Hero.astro';
import Services from '@/components/home/Services.astro';
import Bridge from '@/components/home/Bridge.astro';
import SelectedWork from '@/components/home/SelectedWork.astro';
import Approach from '@/components/home/Approach.astro';
import Process from '@/components/home/Process.astro';
import Intake from '@/components/intake/Intake.astro';
import { locales, type Locale } from '@/i18n';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
---

<!-- Ритм (D15): тёмный Hero → светлые Услуги → тёмные Работы → светлые Подход/Процесс → тёмный приём заявок -->
<Base locale={locale} path="/">
  <Hero locale={locale} />
  <Services locale={locale} />
  <Bridge locale={locale} />
  <SelectedWork locale={locale} />
  <Approach locale={locale} />
  <Process locale={locale} />
  <Intake locale={locale} />
</Base>
