---
/** Согласие на обработку ПД — отдельным документом (требование ст. 9 152-ФЗ). Черновик, см. src/content/legal.ts. */
import Base from '@/layouts/Base.astro';
import LegalBody from '@/components/LegalBody.astro';
import { consent } from '@/content/legal';
import { locales, type Locale } from '@/i18n';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
const doc = consent[locale];
const noindex = import.meta.env.PUBLIC_INDEXING !== '1';
---

<Base locale={locale} path="/consent/" title={`${doc.title} — Krasnoff Development`} noindex={noindex}>
  <LegalBody doc={doc} />
</Base>
