---
/**
 * 05 Реальный результат: место под обезличенную запись Telegram. До записи —
 * явная заглушка с нейтральными формами, а не поддельный скриншот.
 */
import CaseHead from '@/components/cases/CaseHead.astro';
import { mark } from '@/content/mark';
import type { Locale } from '@/i18n';

interface Props {
  locale: Locale;
}
const c = mark[Astro.props.locale].output;
---

<section class="m-out section theme-mark" data-scene="output" aria-labelledby="m-out-title">
  <div class="shell m-out__grid">
    <div class="m-out__text">
      <CaseHead index={c.index} lines={c.titleLines} lead={c.lead} id="m-out-title" />
      <ol class="m-out__flow" data-reveal-group>
        {
          c.flow.map((f, i) => (
            <li data-reveal>
              <span class="label">{String(i + 1).padStart(2, '0')}</span>
              {f}
            </li>
          ))
        }
      </ol>
    </div>
    <figure class="m-out__slot" data-media-slot="mark-case.mp4 · 16:9 · 30–40 s" data-status="placeholder" data-reveal>
      <div class="m-out__device" aria-hidden="true">
        <span class="m-out__notch"></span>
        {[0, 1, 2].map((i) => (
          <span class="m-out__msg" style={`--i:${i}`}>
            <i></i><i></i><i></i>
          </span>
        ))}
      </div>
      <figcaption>
        <strong>{c.pendingTitle}</strong>
        <span>{c.pendingText}</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .m-out__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: 48px var(--col-gap);
    align-items: center;
  }

  .m-out__flow {
    display: flex;
    gap: 0;
    border-top: var(--hairline) solid var(--mark-border);
  }

  .m-out__flow li {
    flex: 1;
    display: grid;
    gap: 6px;
    padding-top: 16px;
    font-weight: 600;
  }

  .m-out__flow li:last-child {
    color: var(--mark-signal);
  }

  .m-out__slot {
    display: grid;
    justify-items: center;
    gap: 24px;
    padding: clamp(28px, 4vw, 56px);
    background:
      repeating-linear-gradient(135deg, rgb(121 220 228 / 0.035) 0 12px, transparent 12px 24px),
      var(--mark-panel);
    border: var(--hairline) dashed var(--mark-border);
    border-radius: 4px;
  }

  .m-out__device {
    position: relative;
    display: grid;
    align-content: start;
    gap: 12px;
    width: min(260px, 70%);
    aspect-ratio: 9 / 16;
    max-height: 420px;
    padding: 40px 16px 16px;
    border: 1.5px solid rgb(232 241 241 / 0.28);
    border-radius: 28px;
  }

  .m-out__notch {
    position: absolute;
    top: 14px;
    left: 50%;
    width: 56px;
    height: 6px;
    margin-left: -28px;
    border-radius: 3px;
    background: rgb(232 241 241 / 0.2);
  }

  .m-out__msg {
    display: grid;
    gap: 6px;
    padding: 12px;
    border-radius: 10px;
    background: rgb(232 241 241 / 0.06);
    border: var(--hairline) solid rgb(121 220 228 / 0.25);
  }

  .m-out__msg i {
    height: 6px;
    border-radius: 2px;
    background: rgb(232 241 241 / 0.22);
  }

  .m-out__msg i:first-child {
    width: 60%;
    background: rgb(121 220 228 / 0.6);
  }

  .m-out__msg i:last-child {
    width: 40%;
  }

  :global(.motion) .m-out__slot.is-in .m-out__msg {
    animation: m-msg 600ms var(--ease-out) both;
    animation-delay: calc(400ms + var(--i) * 260ms);
  }

  @keyframes m-msg {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  .m-out__slot figcaption {
    display: grid;
    gap: 6px;
    text-align: center;
    max-width: 30em;
  }

  .m-out__slot strong {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mark-signal);
  }

  .m-out__slot span {
    font-size: 0.9375rem;
    color: var(--fg-muted);
  }

  @media (max-width: 1023px) {
    .m-out__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
